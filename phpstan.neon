includes:
    - phpstan-baseline.neon

parameters:
    level: 1
    paths:
        - twopayment.php
        - classes
        - controllers
        - override
    fileExtensions:
        - php
    excludePaths:
        - tests/*
    # Real PrestaShop core sources, shallow-cloned to a fixed path at the
    # module's minimum supported version (ps_versions_compliancy in
    # twopayment.php) by the phpstan CI job — see .github/workflows/tests.yml.
    # Locally: run the same clone + alias-generation steps as CI first.
    scanDirectories:
        - /tmp/prestashop-core/classes
        - /tmp/prestashop-core/config
        - /tmp/prestashop-core/src
    scanFiles:
        - phpstan-stubs.php
        # Generated by dev/ci/generate-ps-class-aliases.php — the static
        # mirror of PrestaShopAutoload's runtime `X extends XCore` aliases.
        - /tmp/prestashop-class-aliases.php
