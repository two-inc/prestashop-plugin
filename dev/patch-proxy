#!/bin/bash
# Configure the PrestaShop container to work behind an FRP reverse proxy.
#
# Two problems to solve:
# 1. PrestaShop builds URLs from ps_shop_url + PS_SHOP_DOMAIN config — must
#    point at proxy host, not localhost. Force SSL so all rendered links use
#    https://<proxy>.
# 2. Apache must trust X-Forwarded-Proto so PrestaShop sees SSL as on.
#
# Usage: docker exec <container> bash /var/www/html/modules/twopayment/dev/patch-proxy <proxy_url>
# Undo:  docker exec <container> bash /var/www/html/modules/twopayment/dev/patch-proxy --reset

set -e

PROXY_URL="$1"

DB_NAME="${DB_NAME:-prestashop}"
DB_USER="${DB_USER:-root}"
DB_PASSWD="${DB_PASSWD:-admin}"
DB_HOST="${DB_SERVER:-db}"

mysql_run() {
    mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASSWD" "$DB_NAME" -e "$1"
}

# ── Reset mode ───────────────────────────────────────────────────────────────
if [ "$PROXY_URL" = "--reset" ]; then
    mysql_run "UPDATE ps_configuration SET value='0' WHERE name IN ('PS_SSL_ENABLED','PS_SSL_ENABLED_EVERYWHERE');"
    mysql_run "UPDATE ps_shop_url SET domain='localhost', domain_ssl='localhost' WHERE main=1;"
    rm -f /usr/local/etc/php/conf.d/zz-proxy-prepend.ini /var/www/html/_proxy_prepend.php
    apache2ctl graceful 2>/dev/null || service apache2 reload 2>/dev/null || true
    exit 0
fi

if [ -z "$PROXY_URL" ]; then
    echo "Usage: patch-proxy <proxy_url>"
    echo "       patch-proxy --reset"
    exit 1
fi

# strip scheme
HOST=$(echo "$PROXY_URL" | sed -E 's#^https?://##' | sed -E 's#/$##')

# ── 1. PHP auto_prepend: trust X-Forwarded-Host (FRP forwards proto=http but ─
#       arrives via HTTPS edge — magento plugin hit the same FRP quirk) ──────
PREPEND="/var/www/html/_proxy_prepend.php"
cat > "$PREPEND" <<'EOF'
<?php
// Auto-generated by dev/patch-proxy: trust reverse proxy.
// FRP terminates TLS at edge but forwards X-Forwarded-Proto: http.
// Detect via X-Forwarded-Host presence instead.
if (!empty($_SERVER['HTTP_X_FORWARDED_HOST'])) {
    $_SERVER['HTTPS'] = 'on';
    $_SERVER['SERVER_PORT'] = 443;
    $_SERVER['HTTP_X_FORWARDED_PROTO'] = 'https';
}
EOF
PHP_INI="/usr/local/etc/php/conf.d/zz-proxy-prepend.ini"
if [ ! -f "$PHP_INI" ] || ! grep -q "_proxy_prepend.php" "$PHP_INI" 2>/dev/null; then
    echo "auto_prepend_file=${PREPEND}" > "$PHP_INI"
    apache2ctl graceful 2>/dev/null || service apache2 reload 2>/dev/null || true
fi

# ── 2. Update PrestaShop shop URL + force SSL ────────────────────────────────
mysql_run "UPDATE ps_shop_url SET domain='${HOST}', domain_ssl='${HOST}', physical_uri='/', virtual_uri='' WHERE main=1;"
mysql_run "INSERT INTO ps_configuration (name, value, date_add, date_upd) VALUES ('PS_SHOP_DOMAIN','${HOST}',NOW(),NOW()) ON DUPLICATE KEY UPDATE value='${HOST}', date_upd=NOW();"
mysql_run "INSERT INTO ps_configuration (name, value, date_add, date_upd) VALUES ('PS_SHOP_DOMAIN_SSL','${HOST}',NOW(),NOW()) ON DUPLICATE KEY UPDATE value='${HOST}', date_upd=NOW();"
mysql_run "INSERT INTO ps_configuration (name, value, date_add, date_upd) VALUES ('PS_SSL_ENABLED','1',NOW(),NOW()) ON DUPLICATE KEY UPDATE value='1', date_upd=NOW();"
mysql_run "INSERT INTO ps_configuration (name, value, date_add, date_upd) VALUES ('PS_SSL_ENABLED_EVERYWHERE','1',NOW(),NOW()) ON DUPLICATE KEY UPDATE value='1', date_upd=NOW();"

# ── 3. Clear cache ───────────────────────────────────────────────────────────
rm -rf /var/www/html/var/cache/* 2>/dev/null || true

echo "Proxy configured: ${PROXY_URL}"
