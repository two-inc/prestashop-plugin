# Copy to .env.local and fill in. All vars optional.

# Two merchant API key (defaults to dummy-dev-key)
# TWO_API_KEY=

# Plugin environment: sandbox | production (anything non-production routes to sandbox)
# TWO_ENVIRONMENT=sandbox

# Store country (NO|GB|SE|DK|FI|NL|DE)
# TWO_STORE_COUNTRY=NO

# FRP proxy subdomain user (defaults to $USER)
# PROXY_USER=

# FRP env the tunnel targets: staging | release (defaults to staging). The tunnel
# comes up at <subdomain>.frp.<FRP_ENV>.two.inc; only staging/release are provisioned.
# FRP_ENV=staging

# FRP auth token (defaults to GCP Secret Manager fetch)
# FRP_AUTH_TOKEN=

# Dev-mode-only service URL overrides, each independent of the others. Left
# unset, the Makefile still exports https://<service>.$TWO_ENV.two.inc for all
# three (that is the MAKEFILE's default, not the plugin's - the plugin's own
# per-environment hosts are in the README table). Only honoured while the shop
# is in dev mode. TWO_CHECKOUT_BASE_URL is loaded by the BROWSER, so it cannot
# be host.docker.internal - see "Service URL overrides" in README.md.
# TWO_API_BASE_URL=
# TWO_PORTAL_BASE_URL=
# TWO_CHECKOUT_BASE_URL=
