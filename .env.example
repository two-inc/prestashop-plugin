# Copy to .env and fill in. The Makefile and start-proxy.sh both read it, so
# keep to plain KEY=value lines.

# Two merchant API key (defaults to dummy-dev-key if unset)
TWO_API_KEY=

# frp tunnel (start-proxy.sh). All optional.
# FRP_ENV: staging (default) or release. An inline FRP_ENV=... still wins.
#FRP_ENV=staging
# PROXY_USER: names the tunnel subdomain (defaults to $USER).
#PROXY_USER=
# FRP_AUTH_TOKEN: fetched from Secret Manager when unset.
#FRP_AUTH_TOKEN=
